<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base dark theme -->
    <style name="Base.Theme.ManagePDF" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimaryDark">@color/black</item>
        <item name="colorAccent">@color/black</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:colorBackground">@color/black</item>
    </style>

    <style name="Theme.ManagePDF" parent="Base.Theme.ManagePDF" />
    <style name="Theme.ManagePDF.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="android:background">@color/black</item>
        <!-- Set the text color to white -->
        <item name="android:textColor">@color/white</item>
        <!-- Set the icon color to white -->
        <item name="colorControlNormal">@color/white</item>
        <item name="colorControlActivated">@color/white</item>
        <item name="colorControlHighlight">@color/black</item>
    </style>

    <style name="Theme.ManagePDF.PopupOverlay" parent="ThemeOverlay.AppCompat.Dark">
        <!-- Set the background color to black -->
        <item name="android:background">@color/black</item>
        <!-- Set the text color to white -->
        <item name="android:textColor">@color/white</item>
        <!-- Set the icon color to white -->
        <item name="colorControlNormal">@color/white</item>
        <item name="colorControlActivated">@color/white</item>
        <item name="colorControlHighlight">@color/black</item>
    </style>
</resources>
