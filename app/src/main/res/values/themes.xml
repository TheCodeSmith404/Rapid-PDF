<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ManagePDF" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimaryDark">@color/white</item>
        <item name="colorAccent">@color/white</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:colorBackground">@color/white</item>


    </style>

    <style name="Theme.ManagePDF" parent="Base.Theme.ManagePDF" />
    <style name="Theme.ManagePDF.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" >
        <item name="android:background">@color/white</item>
        <!-- Set the text color to black -->
        <item name="android:textColor">@color/black</item>
        <!-- Set the icon color to black -->
        <item name="colorControlNormal">@color/black</item>
        <item name="colorControlActivated">@color/black</item>
        <item name="colorControlHighlight">@color/white</item>
    </style>

    <style name="Theme.ManagePDF.PopupOverlay" parent="ThemeOverlay.AppCompat.Light">
        <!-- Set the background color to white -->
        <item name="android:background">@color/white</item>
        <!-- Set the text color to black -->
        <item name="android:textColor">@color/black</item>
        <!-- Set the icon color to black -->
        <item name="colorControlNormal">@color/black</item>
        <item name="colorControlActivated">@color/black</item>
        <item name="colorControlHighlight">@color/white</item>
    </style>

</resources>